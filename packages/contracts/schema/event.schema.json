{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schema/event.schema.json",
  "title": "IncidentEvent",
  "description": "A durable, explainable incident produced by the deterministic rule engine. Geometry is normalized image-space in [0,1], not metres.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "source_id",
    "rule_id",
    "rule_version",
    "created_at",
    "first_seen",
    "last_seen",
    "severity",
    "status",
    "title",
    "provenance",
    "is_simulated",
    "explanation",
    "evidence",
    "track_ids",
    "observation_ids"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string" },
    "source_id": { "type": "string" },
    "rule_id": { "type": "string" },
    "rule_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "severity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "status": {
      "enum": ["active", "acknowledged", "resolved", "dismissed"]
    },
    "title": { "type": "string" },
    "provenance": {
      "enum": ["observed", "derived", "configured", "simulated"]
    },
    "is_simulated": { "type": "boolean" },
    "correlation_id": { "type": ["string", "null"] },
    "explanation": { "$ref": "#/$defs/explanation" },
    "evidence": { "type": "object" },
    "track_ids": { "type": "array", "items": { "type": "string" } },
    "observation_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "closed_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "machine", "generated_by"],
      "properties": {
        "human": { "type": "string" },
        "machine": { "type": "object" },
        "generated_by": { "type": "string", "const": "deterministic" }
      }
    }
  }
}
