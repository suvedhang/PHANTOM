# PHANTOM backend configuration.
# Copy to .env and adjust. Never commit a populated .env with secrets.

# --- API server ---
# Host/port for the backend. Keep localhost for development.
PHANTOM_HOST=127.0.0.1
PHANTOM_PORT=8000

# --- Database ---
# SQLite file path. Relative paths resolve against the repository root.
PHANTOM_DB_PATH=output/phantom.db

# --- Frontend CORS ---
# Comma-separated list of allowed browser origins.
PHANTOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo mode ---
# When true, the API refuses to start the real PipeGen pipeline and exposes
# a clearly labelled SIMULATED event source. Real evidence is never produced
# from this mode.
PHANTOM_DEMO_MODE=true

# Auto-start the simulated scene source when DEMO_MODE is true. Set false for a
# clean-start test where nothing runs until an operator presses Start.
PHANTOM_AUTOSTART_MOCK=true

# --- Storage / evidence directories ---
PHANTOM_EVIDENCE_DIR=output/evidence
PHANTOM_EXPORT_DIR=output/exports
PHANTOM_LOG_DIR=output/logs
# Days to retain events/observations. Evidence is preserved during the hackathon.
PHANTOM_RETENTION_DAYS=30

# --- Live ingestion knobs ---
# Maximum observations/second pushed to browsers (UI only, DB still records events).
PHANTOM_UI_FRAME_RATE=8
# Maximum observations read per second from an adapter.
PHANTOM_MAX_INGEST_FPS=30
# Bounded queue depth between adapter ingestion and downstream processing.
PHANTOM_INGEST_QUEUE_SIZE=256
# Seconds without an observation before a running pipeline is marked stale.
PHANTOM_STALE_AFTER_SECONDS=5.0

# --- MQTT (optional) ---
# Leave disabled for local demo. Credentials must come from the environment.
PHANTOM_MQTT_ENABLED=false
PHANTOM_MQTT_HOST=localhost
PHANTOM_MQTT_PORT=1883
PHANTOM_MQTT_USERNAME=
PHANTOM_MQTT_PASSWORD=
PHANTOM_MQTT_TOPIC_PREFIX=phantom

# --- PipeGen integration (Track A, NVIDIA host only) ---
# Exact contract is NOT verified. These values are placeholders and the real
# adapter refuses to run until a verified contract is supplied in
# apps/api/phantom_api/adapters/pipegen.py.
# Path to the PipeGen executable / entrypoint on the NVIDIA host.
PHANTOM_PIPEGEN_EXECUTABLE=
# Directory containing the PipeGen five-stage export (Requirement, Pipeline IR,
# Model, Compiler, Run artifacts).
PHANTOM_PIPEGEN_EXPORT_DIR=
# Version string that must match `pipegen --version` output.
PHANTOM_PIPEGEN_EXPECTED_VERSION=0.5.1
